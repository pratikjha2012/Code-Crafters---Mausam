# =================================================================
# MAUSAM LIVE AI WEATHER PLATFORM - ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to .env and insert your real production API keys.
# Do NOT commit your real .env file to public version control.

# Server Port
PORT=3001

# Real Weather Provider Key (Optional if using Open-Meteo high-res ensemble by default,
# or provide an OpenWeatherMap / WeatherAPI key)
WEATHER_API_KEY=

# LLM Agent Provider Key (Gemini, OpenAI, or Anthropic compatible)
# When left empty, the server automatically uses the built-in deterministic
# meteorological NLP tool-calling agent with live weather data.
LLM_API_KEY=

# ElevenLabs Text-To-Speech API Key (Required for live ElevenLabs voice synthesis)
ELEVENLABS_API_KEY=

# ElevenLabs Voice ID (Defaults to natural, professional meteorological voice)
# Examples: 21m00Tcm4TlvDq8ikWAM (Rachel), EXAVITQu4vr4xnSDxMaL (Bella)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
